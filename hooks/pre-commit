#!/usr/bin/env bash
set -euo pipefail

status=0

while IFS= read -r file; do
  case "$file" in
    *.md|*.txt|*.sh|*.yml|*.yaml|*.json)
      ;;
    *)
      continue
      ;;
  esac

  if ! git rev-parse --verify --quiet ":$file" >/dev/null; then
    continue
  fi

  if git show ":$file" | ./tools/redflag-scan.sh --fail >/dev/null 2>&1; then
    :
  else
    code=$?
    if [[ "$code" -eq 2 ]]; then
      echo "[pre-commit] blocked: possible sensitive patterns detected in staged file: $file" >&2
      git show ":$file" | ./tools/redflag-scan.sh || true
      status=1
    else
      echo "[pre-commit] warning: scanner error while checking $file" >&2
      status=1
    fi
  fi
done < <(git diff --cached --name-only)

if [[ "$status" -ne 0 ]]; then
  echo "[pre-commit] tip: sanitize/redact, then re-stage and commit." >&2
  exit 1
fi

exit 0
