#!/usr/bin/env bash
set -euo pipefail

# Check only staged files, but ignore controlled test fixtures.
staged_files="$(git diff --cached --name-only)"

filtered_files="$(printf '%s\n' "$staged_files" | grep -vE '^examples/fixtures/' || true)"

if [[ -z "$filtered_files" ]]; then
  exit 0
fi

while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  if [[ -f "$file" ]]; then
    if ./tools/redflag-scan.sh --fail "$file" >/dev/null 2>&1; then
      :
    else
      code=$?
      if [[ "$code" -eq 2 ]]; then
        echo "[pre-commit] blocked: possible sensitive patterns detected in staged file: $file" >&2
        ./tools/redflag-scan.sh "$file" || true
        echo "[pre-commit] tip: sanitize/redact, then re-stage and commit." >&2
        exit 1
      else
        echo "[pre-commit] warning: scanner error while checking $file" >&2
        exit 1
      fi
    fi
  fi
done <<< "$filtered_files"
